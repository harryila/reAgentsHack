L445: - # Rationalization of the Spline modeling, see e.g.:
L446: - # Greenland S. Dose-response and trend analysis in epidemiology: alternatives to categorical
L447: analysis.
L448: - # Epidemiology. 1995 Jul;6(4):356-65.
L449: - # [http://www.ncbi.nlm.nih.gov/pubmed/7548341](http://www.ncbi.nlm.nih.gov/pubmed/7548341)
L450: - # [http://dx.doi.org/10.1097/00001648-199507000-00005](http://dx.doi.org/10.1097/00001648-199507000-00005)
L451: - # and Wikipedia
L452: - # [http://en.wikipedia.org/wiki/Spline_(mathematics)](http://en.wikipedia.org/wiki/Spline_(mathematics))
L453: **> # Modification of the vitamin C effect by the placebo-day postexercise FEF60 level (PlEnd)**
L454: - LinearModel.41 <- lm(End_Ratio ~ 1, data=SchachterFEF60)
L455: - summary(LinearModel.41)
L456: Coefficients:
L457: Estimate Std. Error t value Pr(>|t|)
L458: (Intercept)  32.88   20.08  1.637   0.13
L459: Residual standard error: 69.56 on 11 degrees of freedom
L460: - LinearModel. **42** <- lm(End_Ratio ~ 1 + PlEnd, data=SchachterFEF60)
L461: - summary(LinearModel.42)
L462: Coefficients:
L463: Estimate Std. Error t value Pr(>|t|)
L464: (Intercept)  105.28   20.22  5.207 0.000397 ***
L465: **PlEnd     -49.65   11.08 -4.479 0.001181 ****
L466: Residual standard error: 42.08 on 10 degrees of freedom
L467: Multiple R-squared: 0.6673, Adjusted R-squared: 0.6341
L468: F-statistic: 20.06 on 1 and 10 DF, p-value: 0.001181
L469: **> # This LR-test below shows that there is significant improvement in the model fit**
L470: **> # when the placebo-day postexercise FEF60 level is added**
L471: - lrtest(LinearModel.41,LinearModel.42)
L472: Likelihood ratio test
L473: Model 1: End_Ratio ~ 1
L474: Model 2: End_Ratio ~ 1 + PlEnd
L475: #Df LogLik Df Chisq Pr(>Chisq)
L476: 1  2 -67.411
L477: 2  3 -60.807 1 **13.208** 0.0002788 ***
L478: **> # These models below search for the optimal location of the spline knot**
L479: **in the range 0.9 to 1.3 L/s**
L480: - SchachterFEF60$w09 <- with(SchachterFEF60, **(PlEnd>0.9)*(PlEnd-0.9))**
L481: - LinearModel.409 <- lm(End_Ratio ~ 1 + PlEnd + w09, data=SchachterFEF60)
L482: - lrtest(LinearModel.42,LinearModel.409)
L483: Likelihood ratio test
L484: Model 1: End_Ratio ~ 1 + PlEnd
L485: Model 2: End_Ratio ~ 1 + PlEnd + w09
L486: #Df LogLik Df Chisq Pr(>Chisq)
L487: 1  3 -60.807
L488: 2  4 -55.549 1 **10.517** 0.001183 **
L489: - SchachterFEF60$w10 <- with(SchachterFEF60, **(PlEnd>1.0)*(PlEnd-1.0))**
L490: - LinearModel.410 <- lm(End_Ratio ~ 1 + PlEnd + w10, data=SchachterFEF60)
L491: - lrtest(LinearModel.42,LinearModel.410)
L492: Likelihood ratio test
L493: Model 1: End_Ratio ~ 1 + PlEnd
L494: Model 2: End_Ratio ~ 1 + PlEnd + w10
L495: #Df LogLik Df Chisq Pr(>Chisq)
L496: 1  3 -60.807
L497: 2  4 -55.201 1 **11.212** 0.0008126 ***
L498: 6
L499: **> SchachterFEF60$w11 <- with(SchachterFEF60, (PlEnd>1.1)*(PlEnd-1.1))**
L500: - LinearModel.411 <- lm(End_Ratio ~ 1 + PlEnd + w11, data=SchachterFEF60)
L501: - summary(LinearModel.411)
